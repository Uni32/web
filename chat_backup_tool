                const blob =
                    new Blob(
                        [standaloneHtml],
                        {
                            type:
                                "text/html;charset=utf-8"
                        }
                    );


                const url =
                    URL.createObjectURL(blob);


                const a =
                    document.createElement("a");


                a.href = url;

                a.download =
                    "chat_backup.html";


                document.body.appendChild(a);

                a.click();

                document.body.removeChild(a);


                URL.revokeObjectURL(url);
            }
        );

    </script>

</body>
</html>
